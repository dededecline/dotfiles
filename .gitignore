# Allowlist, not blocklist.
#
# ~/.config is where every application writes its config, so ignoring by name
# structurally loses the race: context7, auth0, ldcli, raycast, akuity, yarn
# and others all created top-level directories on their own, and one of them
# (context7) wrote an OAuth token. Everything at the top level is therefore
# ignored unless named below. A new tool's directory is invisible to git until
# someone deliberately adds it here.
#
# Mirrors the pattern already used by claude/.gitignore and codex/.gitignore.

/*

# Repo metadata and documentation
!/.editorconfig
!/.gitignore
!/CLAUDE.md
!/Commands.md
!/README.md
!/setup.sh

# Managed tool configuration
!/.system/
!/aerospace/
!/atuin/
!/bat/
!/claude/
!/codex/
!/fastfetch/
!/fish/
!/gh/
!/git/
!/glow/
!/kitty/
!/lsd/
!/mise/
!/nvim/
!/ruff/
!/shellcheck/
!/sketchybar/
!/starship/
!/tmux/
!/tombi/
!/zed/

# 1Password may write credentials here; only the telemetry opt-in is tracked.
!/1Password/
/1Password/*
!/1Password/telemetry-enabled

# =====================================================================
#  Generated or sensitive files inside the allowed directories above
# =====================================================================

# Injected from 1Password by .system/setup/secrets.sh
.system/sensitive/*
!.system/sensitive/.gitkeep

# Generated at setup time from labels/
.system/profiles/machines/*/Brewfile

# Rendered from templates (carry identity or credentials)
git/config
fish/functions/clone.fish
glow/glow.yml
gh/hosts.yml

# Machine-local shell state and overrides
fish/fish_variables
fish/fish_history
config.local.fish
*.local.fish

# Symlink generated per hostname by secrets.sh
fastfetch/logo.txt

# Tool runtime state
atuin/history.db
atuin/history.db-*
atuin/key
atuin/session
bat/themes/
nvim/lazy-lock.json
zed/conversations/
zed/prompts/

# Generated by setup.sh configure_codex; edit the .source. files instead
codex/config.toml
codex/auth.json
codex/history.jsonl
codex/sessions/
codex/log/
codex/cache/

# =====================================================================
#  Generic nets, in case something lands inside an allowed directory
# =====================================================================

.DS_Store
*.swp
*.swo
*~

*.local
*.local.*

# Unanchored on purpose: `/*` above only ignores the top level, so these must
# stay depth-independent to catch a tool writing logs or cache into an allowed
# directory (zed/logs/, nvim/.cache/, .system/logs/).
logs/
cache/
.cache/
debug/
file-history/
plans/
projects/
todos/
session-env/
shell-snapshots/
history.jsonl
observe.yaml

.npmrc
.env
*.pem
*.key
credentials.json
secrets.json
