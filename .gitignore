# Sensitive files - NEVER commit these
sensitive/*
!sensitive/.gitkeep
*.local.fish
config.local.fish

# Generated from templates/*.tpl (1Password or envsubst)
git/config
fish/functions/clone.fish
glow/glow.yml
.brewfile.combined
.brewfile.preprocessed

# System files
.DS_Store
*.swp
*.swo
*~

# Fish auto-generated files
fish/fish_variables
fish/fish_history

# Neovim lock file (regenerated automatically)
nvim/lazy-lock.json

# GitHub CLI credentials
gh/hosts.yml

# 1Password CLI (contains session data)
op/

# Atuin (allow config, ignore database and key)
atuin/history.db
atuin/history.db-*
atuin/key

# Cache directories
.cache/

# Runtime logs
logs/

# Local overrides pattern
*.local
*.local.*

# Secrets and credentials (safety net)
.npmrc
.env
*.pem
*.key
credentials.json
secrets.json


# Application data that shouldn't be tracked
github-copilot/
raycast/
wireshark/

# Zed editor state
zed/

# ArgoCD (may contain cluster info)
/argocd/

# Work-specific Claude skills (symlinks retrieved from 1Password)
claude/skills/argocd
claude/skills/astro
claude/skills/bastion_zero
claude/skills/lrl-cli
claude/skills/observe
claude/skills/spacectl

# Generated Claude skills directory
sensitive/claude-skills/

# Yarn global packages (regenerated)
yarn/
