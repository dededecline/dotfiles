# Sensitive files to never commit
.system/sensitive/*
!.system/sensitive/.gitkeep
*.local.fish
config.local.fish

# Generated from .system/templates/*.tpl (1Password or envsubst)
git/config
fish/functions/clone.fish
glow/glow.yml
bat/themes/

# Generated per-machine Brewfile (from labels/ via setup.sh prepare_brewfile)
.system/profiles/machines/*/Brewfile

# Machine-specific symlinks (generated by secrets.sh)
fastfetch/logo.txt

# System files
.DS_Store
*.swp
*.swo
*~

# Fish auto-generated files
fish/fish_variables
fish/fish_history

# Neovim lock file (regenerated automatically)
nvim/lazy-lock.json

# GitHub CLI credentials
gh/hosts.yml

# 1Password CLI (contains session data)
op/

# Atuin (allow config, ignore database and key)
atuin/history.db
atuin/history.db-*
atuin/key

# Cache directories
.cache/

# Runtime logs
logs/

# Local overrides pattern
*.local
*.local.*

# Secrets and credentials (safety net)
.npmrc
.env
*.pem
*.key
credentials.json
secrets.json


# Application data that shouldn't be tracked
github-copilot/
raycast/
wireshark/

# Zed
zed/conversations/
zed/prompts/

# ArgoCD (may contain cluster info)
/argocd/

# Generated Claude skills directory
.system/sensitive/claude-skills/

# Yarn global packages (regenerated)
yarn/

# Claude
cache/
debug/
file-history/
plans/
projects/
todos/
session-env/
shell-snapshots/
history.jsonl

# Claude Code per-project state (settings.local.json, scheduled_tasks.lock, etc.)
/.claude/

observe.yaml
ldcli/
auth0/
