{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Display settings - Catppuccin Frappe with Lavender accents
  "display": {
    "separator": " ~> ",
    "color": {
      "separator": "38;2;148;156;187"
    }
  },

  // Logo configuration - Custom ASCII art with Catppuccin Frappe Maroon
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;234;153;156"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },

  // Modules to display - Catppuccin Frappe colors
  // @theme:start
  // Mauve: 38;2;202;158;230 | Blue: 38;2;140;170;238 | Teal: 38;2;129;200;190 | Peach: 38;2;239;159;118 | Subtext1: 38;2;181;191;226
  // @theme:end
  "modules": [
    {
      "type": "title",
      "keyColor": "38;2;202;158;230"
    },
    {
      "type": "separator",
      "string": "─"
    },

    // 󰌢 Hardware (Mauve)
    "break",
    { "type": "custom", "format": "{#1;38;2;202;158;230}󰌢 Hardware{#}" },
    {
      "type": "host",
      "key": "├ Host   ",
      "keyColor": "38;2;202;158;230"
    },
    {
      "type": "cpu",
      "key": "├ CPU    ",
      "keyColor": "38;2;202;158;230"
    },
    {
      "type": "gpu",
      "key": "├ GPU    ",
      "keyColor": "38;2;202;158;230",
      "format": "{name} ({core-count}) @ {frequency}"
    },
    {
      "type": "memory",
      "key": "├ Memory ",
      "keyColor": "38;2;202;158;230"
    },
    {
      "type": "disk",
      "key": "├ Disk   ",
      "keyColor": "38;2;202;158;230",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "swap",
      "key": "├ Swap   ",
      "keyColor": "38;2;202;158;230"
    },
    {
      "type": "display",
      "key": "├ Display",
      "keyColor": "38;2;202;158;230",
      "format": "{scaled-width}x{scaled-height} in {inch}\", {refresh-rate} Hz [{type}]{?is-primary} *{?}"
    },
    {
      "type": "battery",
      "key": "└ Charge ",
      "keyColor": "38;2;202;158;230"
    },

    // 󰀵 Firmware (Blue)
    "break",
    { "type": "custom", "format": "{#1;38;2;140;170;238}󰀵 Firmware{#}" },
    {
      "type": "os",
      "key": "├ OS    ",
      "keyColor": "38;2;140;170;238"
    },
    {
      "type": "kernel",
      "key": "├ Kernel",
      "keyColor": "38;2;140;170;238"
    },
    {
      "type": "uptime",
      "key": "└ Uptime",
      "keyColor": "38;2;140;170;238"
    },

    // 󰏗 Software (Teal)
    "break",
    { "type": "custom", "format": "{#1;38;2;129;200;190}󰏗 Software{#}" },
    {
      "type": "command",
      "key": "├ Packages",
      "keyColor": "38;2;129;200;190",
      "text": "printf '%s (brew), %s (brew-cask), %s (mas)' \"$(ls -1 /opt/homebrew/Cellar 2>/dev/null | wc -l | tr -d ' ')\" \"$(ls -1 /opt/homebrew/Caskroom 2>/dev/null | wc -l | tr -d ' ')\" \"$(mas list 2>/dev/null | wc -l | tr -d ' ')\""
    },
    {
      "type": "shell",
      "key": "├ Shell   ",
      "keyColor": "38;2;129;200;190"
    },
    {
      "type": "terminal",
      "key": "├ Terminal",
      "keyColor": "38;2;129;200;190"
    },
    {
      "type": "command",
      "key": "└ WM      ",
      "keyColor": "38;2;129;200;190",
      "text": "pgrep -xq AeroSpace && echo \"AeroSpace $(aerospace --version 2>/dev/null | head -1 | awk '{print $5}')\" || echo 'Quartz Compositor'"
    },

    // 󰏘 Theme (Lavender)
    "break",
    { "type": "custom", "format": "{#1;38;2;186;187;241}󰏘 Theme{#}" },
    {
      "type": "command",
      "key": "├ OS     ",
      "keyColor": "38;2;186;187;241",
      "text": "defaults read -g AppleInterfaceStyle &>/dev/null && echo 'dark' || echo 'light'"
    },
    {
      "type": "command",
      "key": "├ Desktop",
      "keyColor": "38;2;186;187;241",
      "text": "awk -F'\"' '/^name/ {print $2}' ~/.config/themes/theme.toml"
    },
    {
      "type": "terminalfont",
      "key": "└ Font   ",
      "keyColor": "38;2;186;187;241"
    },

    // 󰤨 Network (Peach)
    "break",
    { "type": "custom", "format": "{#1;38;2;239;159;118}󰤨 Network{#}" },
    {
      "type": "publicip",
      "key": "├ Public IP",
      "keyColor": "38;2;239;159;118",
      "timeout": 1000
    },
    {
      "type": "localip",
      "key": "├ Local IP ",
      "keyColor": "38;2;239;159;118"
    },
    {
      "type": "dns",
      "key": "├ DNS      ",
      "keyColor": "38;2;239;159;118"
    },
    {
      "type": "wifi",
      "key": "└ WiFi     ",
      "keyColor": "38;2;239;159;118"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
