{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // Display settings - Catppuccin Frappe with Lavender accents
    "display": {
        "separator": "  "
    },

    // Logo configuration - Custom ASCII art with Catppuccin Frappe Maroon
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "38;2;234;153;156"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },

    // Modules to display - Catppuccin Frappe colors
    // Mauve: 38;2;202;158;230 | Blue: 38;2;140;170;238 | Teal: 38;2;129;200;190 | Peach: 38;2;239;159;118
    "modules": [
        {
            "type": "title",
            "keyColor": "38;2;202;158;230"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "󰀵  OS",
            "keyColor": "38;2;202;158;230"
        },
        {
            "type": "host",
            "key": "󰌢  Host",
            "keyColor": "38;2;202;158;230"
        },
        {
            "type": "kernel",
            "key": "󰒋  Kernel",
            "keyColor": "38;2;202;158;230"
        },
        {
            "type": "uptime",
            "key": "󰅐  Uptime",
            "keyColor": "38;2;202;158;230"
        },
        {
            "type": "packages",
            "key": "󰏖  Packages",
            "keyColor": "38;2;202;158;230"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "38;2;202;158;230"
        },
        {
            "type": "terminal",
            "key": "  Terminal",
            "keyColor": "38;2;202;158;230"
        },
        {
            "type": "terminalfont",
            "key": "  Font",
            "keyColor": "38;2;202;158;230"
        },
        "break",
        {
            "type": "cpu",
            "key": "󰻠  CPU",
            "keyColor": "38;2;140;170;238"
        },
        {
            "type": "gpu",
            "key": "󰢮  GPU",
            "keyColor": "38;2;140;170;238"
        },
        {
            "type": "memory",
            "key": "󰍛  Memory",
            "keyColor": "38;2;140;170;238"
        },
        {
            "type": "swap",
            "key": "󰓡  Swap",
            "keyColor": "38;2;140;170;238"
        },
        {
            "type": "disk",
            "key": "󰋊  Disk",
            "keyColor": "38;2;140;170;238",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "󰁹  Battery",
            "keyColor": "38;2;140;170;238"
        },
        "break",
        {
            "type": "display",
            "key": "󰍹  Display",
            "keyColor": "38;2;129;200;190"
        },
        {
            "type": "brightness",
            "key": "󰃟  Brightness",
            "keyColor": "38;2;129;200;190"
        },
        {
            "type": "wm",
            "key": "  WM",
            "keyColor": "38;2;129;200;190"
        },
        "break",
        {
            "type": "localip",
            "key": "󰩟  Local IP",
            "keyColor": "38;2;239;159;118"
        },
        {
            "type": "wifi",
            "key": "󰤨  WiFi",
            "keyColor": "38;2;239;159;118"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
