// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-7-thinking-latest",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "file_types": {
    "Fish": ["*.fish.tpl"]
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.ruff_cache",
    "**/.ropeproject",
    "**/.venv",
    "**/venv",
    "**/__pycache__"
  ],
  "languages": {
    "JSONC": {
      "prettier": {
        "trailingComma": "none"
      }
    },
    "Fish": {
      "formatter": {
        "external": {
          "command": "fish_indent"
        }
      }
    },
    "Python": {
      "language_servers": ["basedpyright", "ruff", "!pyright"],
      "format_on_save": "on",
      "formatter": [
        {
          "external": {
            "command": "ruff",
            "arguments": ["format", "-"]
          }
        },
        { "code_action": "source.fixAll.ruff" }
      ]
    },
    "Shell Script": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}"]
        }
      }
    }
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "python.analysis": {
          "diagnosticMode": "workspace",
          "exclude": ["**/__pycache__", "**/.venv", "tests/"]
        },
        "python": {
          "pythonPath": ".venv/bin/python"
        }
      }
    }
  },
  "window_decorations": "client",
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_features": {
    "calt": true,
    "liga": true
  },
  "ui_font_family": "Maple Mono NF",
  "title_bar": {
    "show_branch_status_icon": true
  },
  "show_whitespaces": "all",
  "which_key": {
    "enabled": true
  },
  "autosave": "on_focus_change",
  "session": {
    "trust_all_worktrees": true
  },
  "on_last_window_closed": "quit_app",
  "when_closing_with_no_tabs": "close_window",
  "icon_theme": "Catppuccin Frappé",
  "ui_font_size": 16,
  "buffer_font_size": 12,
  "buffer_font_weight": 500,
  "buffer_line_height": "comfortable",
  "terminal": {
    "font_family": "Maple Mono NF",
    "font_size": 12,
    "font_weight": 500,
    "line_height": "comfortable"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Frappe (Blur)"
  },
  "search": {
    "include_ignored": false
  },
  "auto_install_extensions": {
    "catppuccin-icons": true,
    "csharp": true,
    "csv": true,
    "dart": true,
    "dockerfile": true,
    "editorconfig": true,
    "fish": true,
    "git-firefly": true,
    "go-snippets": true,
    "graphql": true,
    "groovy": true,
    "helm": true,
    "html": true,
    "ini": true,
    "java": true,
    "jinja2": true,
    "jsonnet": true,
    "kotlin": true,
    "log": true,
    "lua": true,
    "make": true,
    "markdown-oxide": true,
    "nix": true,
    "nextjs-react-snippets": true,
    "python-requirements": true,
    "python-snippets": true,
    "rainbow-csv": true,
    "react-typescript-snippets": true,
    "scala": true,
    "sql": true,
    "swift": true,
    "terraform": true,
    "toml": true,
    "tombi": true,
    "verilog": true,
    "vue": true,
    "xml": true
  }
}
