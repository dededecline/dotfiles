[
  {
    "label": "Ruff+Basedpyright check",
    "command": "echo 'Running ruff check and basedpyright...' && echo '\n' && echo 'Ruff check:' && uvx ruff check . && echo '\n' && echo 'Basedpyright check:' && uvx basedpyright .",
    "reveal_target": "dock"
  },
  {
    "label": "Ruff check",
    "command": "uvx ruff check .",
    "reveal_target": "dock"
  },
  {
    "label": "Ruff format",
    "command": "uvx ruff format .",
    "reveal_target": "dock"
  },
  {
    "label": "Basedpyright check",
    "command": "uvx basedpyright .",
    "reveal_target": "dock"
  },
  {
    "label": "Pytest",
    "command": "uv run pytest",
    "reveal_target": "dock"
  },
  {
    "label": "Pytest (current file)",
    "command": "uv run pytest",
    "args": ["$ZED_FILE"],
    "reveal_target": "dock"
  },
  {
    "label": "Run python file",
    "command": "uv run python3",
    "args": ["$ZED_FILE"],
    "use_new_terminal": true,
    "env": {
      "PYTHONPATH": "."
    }
  }
]
