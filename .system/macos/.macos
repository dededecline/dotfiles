#!/usr/bin/env bash

# macOS configuration script
# Run: chmod +x .macos && ./.macos

DOTFILES="${DOTFILES:-$HOME/.config}"
SYSTEM_DIR="${SYSTEM_DIR:-$DOTFILES/.system}"
source "$SYSTEM_DIR/setup/lib/profiles.sh"

# Close any open System Settings panes to prevent overriding changes
osascript -e 'tell application "System Settings" to quit'

# Ask for administrator password upfront
sudo -v

# Keep-alive: update existing sudo timestamp until script finishes
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

###############################################################################
# Computer Name                                                               #
###############################################################################

# Set computer name (as shown in System Preferences > Sharing)
# Uses MACHINE_HOSTNAME from setup.sh or falls back to current hostname
HOSTNAME="${MACHINE_HOSTNAME:-$(hostname -s)}"
sudo scutil --set ComputerName "$HOSTNAME"
sudo scutil --set HostName "$HOSTNAME"
sudo scutil --set LocalHostName "$HOSTNAME"
sudo defaults write /Library/Preferences/SystemConfiguration/com.apple.smb.server NetBIOSName -string "$HOSTNAME"

###############################################################################
# General UI/UX                                                               #
###############################################################################

# Set interface style to Dark mode
defaults write NSGlobalDomain AppleInterfaceStyle -string "Dark"

# Auto-hide menu bar
defaults write NSGlobalDomain _HIHideMenuBar -bool true

# Expand save panel by default
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true

# Set sidebar icon size to small
defaults write NSGlobalDomain NSTableViewDefaultSizeMode -int 1

# Disable automatic termination of inactive apps
defaults write NSGlobalDomain NSDisableAutomaticTermination -bool true

###############################################################################
# Input: Keyboard & Text                                                      #
###############################################################################

# Disable press-and-hold for keys in favor of key repeat
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false

# Disable automatic capitalization
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false

# Disable smart dashes
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false

# Disable automatic period substitution
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false

# Disable smart quotes
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false

# Disable auto-correct
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false

# Spotlight shortcuts are re-disabled at login by the com.user.spotlight-shortcuts LaunchAgent

###############################################################################
# Sound                                                                       #
###############################################################################

# Disable system UI sound effects
defaults write NSGlobalDomain com.apple.sound.beep.volume -float 0.0

# Disable feedback sound when changing volume
defaults write NSGlobalDomain com.apple.sound.beep.feedback -bool false

###############################################################################
# Trackpad                                                                    #
###############################################################################

# Disable tap to click
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool false
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool false

# Disable three-finger drag
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool false
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool false

# Enable three-finger horizontal swipe (spaces/fullscreen)
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerHorizSwipeGesture -int 2
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerHorizSwipeGesture -int 2

# Enable four-finger horizontal swipe (spaces/fullscreen)
defaults write com.apple.AppleMultitouchTrackpad TrackpadFourFingerHorizSwipeGesture -int 2
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadFourFingerHorizSwipeGesture -int 2

# Enable swipe between pages
defaults write NSGlobalDomain AppleEnableSwipeNavigateWithScrolls -bool true

###############################################################################
# Finder                                                                      #
###############################################################################

# Show POSIX path in window title
defaults write com.apple.finder _FXShowPosixPathInTitle -bool true

# Disable desktop icons
defaults write com.apple.finder CreateDesktop -bool false

# Disable warning when changing file extension
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

# Set default search scope to current folder
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"

# Show quit menu item for Finder
defaults write com.apple.finder QuitMenuItem -bool true

# Show hidden files
defaults write com.apple.finder AppleShowAllFiles -bool true

###############################################################################
# Control Center                                                              #
###############################################################################

# Show battery percentage
defaults write com.apple.controlcenter BatteryShowPercentage -bool true

# Show Bluetooth in menu bar
defaults write com.apple.controlcenter Bluetooth -int 2

###############################################################################
# Screenshots                                                                 #
###############################################################################

# Disable shadow in screenshots
defaults write com.apple.screencapture disable-shadow -bool true

# Disable thumbnail preview
defaults write com.apple.screencapture show-thumbnail -bool false

# Save screenshots to clipboard
defaults write com.apple.screencapture target -string "clipboard"

# Save screenshots in PNG format
defaults write com.apple.screencapture type -string "png"

###############################################################################
# Launch Services                                                             #
###############################################################################

# Disable quarantine dialog for downloaded applications
defaults write com.apple.LaunchServices LSQuarantine -bool false

###############################################################################
# Apple Intelligence                                                          #
###############################################################################

# TODO: Implement functioning Apple Intelligence disabling

###############################################################################
# Raycast Configuration                                                       #
###############################################################################

# Disable Spotlight keyboard shortcuts to avoid conflicts with Raycast (⌥Space)
# Spotlight: Cmd+Space (64)
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 "{enabled = 0; value = { parameters = (65535, 49, 1048576); type = 'standard'; }; }"

# Spotlight: Cmd+Opt+Space (65)
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 65 "{enabled = 0; value = { parameters = (65535, 49, 1572864); type = 'standard'; }; }"

# Show Apps (Spotlight): key 160
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 160 "{enabled = 0; value = { parameters = (65535, 65535, 0); type = 'standard'; }; }"

# Disable Input Sources keyboard shortcuts that may conflict
# Select previous input source: Cmd+Space (60)
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 60 "{enabled = 0; value = { parameters = (32, 49, 1048576); type = 'standard'; }; }"

# Select next input source: Cmd+Opt+Space (61)
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 61 "{enabled = 0; value = { parameters = (32, 49, 1572864); type = 'standard'; }; }"

# Disable Siri keyboard shortcut to avoid conflicts
# Siri: Cmd+Space (varies by macOS version)
defaults write com.apple.Siri StatusMenuVisible -bool false
defaults write com.apple.Siri UserHasDeclinedEnable -bool true

###############################################################################
# Touch ID for sudo                                                           #
###############################################################################

# Enable Touch ID for sudo authentication (survives macOS updates)
SUDO_LOCAL="/etc/pam.d/sudo_local"
if ! grep -q "pam_tid.so" "$SUDO_LOCAL" 2>/dev/null; then
	echo "auth       sufficient     pam_tid.so" | sudo tee -a "$SUDO_LOCAL" > /dev/null
	echo "Touch ID for sudo enabled."
else
	echo "Touch ID for sudo already configured."
fi

###############################################################################
# Full Disk Access for Terminal                                               #
###############################################################################

# Check if Kitty has Full Disk Access by trying to access a protected directory
check_full_disk_access() {
	local terminal_app="/Applications/kitty.app"

	if [[ ! -d "$terminal_app" ]]; then
		echo "Kitty not found at $terminal_app - skipping Full Disk Access check"
		return 0
	fi

	# Try to access a protected directory (Library/Safari exists on all macOS systems)
	if ls ~/Library/Safari &>/dev/null; then
		echo "Full Disk Access: already granted to Kitty"
		return 0
	else
		echo ""
		echo "==================================================================================="
		echo "  Full Disk Access Required"
		echo "==================================================================================="
		echo ""
		echo "Kitty terminal needs Full Disk Access to install Parallels and other apps."
		echo ""
		echo "Please follow these steps:"
		echo "  1. System Settings will open to Privacy & Security > Full Disk Access"
		echo "  2. Click the lock icon and authenticate"
		echo "  3. Click the '+' button and add: /Applications/kitty.app"
		echo "  4. Restart Kitty terminal"
		echo "  5. Re-run this setup script"
		echo ""
		echo "==================================================================================="
		echo ""

		# Open System Settings to Full Disk Access pane
		open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"

		# Wait for user to grant access
		read -p "Press Enter after granting Full Disk Access and restarting Kitty..."

		# Check again
		if ls ~/Library/Safari &>/dev/null; then
			echo "Full Disk Access: confirmed"
			return 0
		else
			echo "Full Disk Access: not detected (you may need to restart Kitty)"
			echo "Please restart Kitty and re-run this setup script."
			return 1
		fi
	fi
}

# Run the check
check_full_disk_access

###############################################################################
# Remote Access (server only)                                                 #
###############################################################################

if is_machine_in_group "$HOSTNAME" "server"; then
    # Enable Remote Login (SSH) — allows standard SSH access
    sudo launchctl enable system/com.openssh.sshd
    sudo launchctl bootstrap system /System/Library/LaunchDaemons/ssh.plist 2>/dev/null || true

    # Enable macOS Application Firewall (stealth mode — no response to probes)
    sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on
    sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on

    # Allowlist RustDesk for incoming connections (prevents re-prompting after updates)
    if [[ -d "/Applications/RustDesk.app" ]]; then
        sudo /usr/libexec/ApplicationFirewall/socketfilterfw --add /Applications/RustDesk.app/Contents/MacOS/RustDesk
        sudo /usr/libexec/ApplicationFirewall/socketfilterfw --unblockapp /Applications/RustDesk.app/Contents/MacOS/RustDesk
    fi

    # SSH ListenAddress restriction is handled in tailscale.sh (after Tailscale is confirmed running)
fi

# RustDesk requires manual approval in System Settings > Privacy & Security:
#   - Accessibility
#   - Screen Recording
#   - Input Monitoring
# These cannot be granted programmatically without MDM.
# RustDesk will prompt the user on first launch.

###############################################################################
# Kill affected applications                                                  #
###############################################################################

for app in "ControlCenter" \
	"Finder" \
	"SystemUIServer" \
	"cfprefsd"; do
	killall "${app}" &> /dev/null
done

echo "Done. Note that some of these changes require a logout/restart to take effect."
