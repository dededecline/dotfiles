# Ignore everything by default
*

# Track configuration
!.gitignore
!settings.jsonc
!agents/
!agents/**
!commands/
!commands/**
!skills/
!skills/**

# Local plugins (in-repo marketplace; runtime install state lives under plugins/)
!local-plugins/
