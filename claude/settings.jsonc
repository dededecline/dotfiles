      "Bash(kubectl create:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl set:*)",
      "Bash(kubectl run:*)",
      "Bash(k apply:*)",
      "Bash(k create:*)",
      "Bash(k delete:*)",
      "Bash(k edit:*)",
      "Bash(k exec:*)",
      "Bash(k patch:*)",
      "Bash(k replace:*)",
      "Bash(k scale:*)",
      "Bash(k rollout:*)",
      "Bash(k set:*)",
      "Bash(k run:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(tofu plan:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(tofu import:*)",
      "Bash(aws --profile prod-admin:*)",
      "Bash(aws --profile lrl-prd-admin:*)",
      "Bash(aws --profile lrl-prd-dbwrite:*)",
      "Bash(aws --profile lrl-prd-oncall:*)",
      "Bash(env AWS_PROFILE=prod-admin:*)",
      "Bash(env AWS_PROFILE=lrl-prd-admin:*)",
      "Bash(env AWS_PROFILE=lrl-prd-dbwrite:*)",
      "Bash(AWS_PROFILE=prod-admin:*)",
      "Bash(AWS_PROFILE=lrl-prd-admin:*)",
      "Bash(AWS_PROFILE=lrl-prd-dbwrite:*)",
      "Bash(op item create:*)",
      "Bash(op item edit:*)",
      "Bash(op item delete:*)",
      "Bash(op vault create:*)",
      "Bash(op vault delete:*)",
      "Bash(op document create:*)",
      "Bash(op document edit:*)",
      "Bash(op document delete:*)",
      "Bash(warpstream cli delete-acls:*)",
      "Bash(warpstream cli delete-broker-config:*)",
      "Bash(warpstream cli delete-topics:*)",
      "Bash(warpstream cli-old delete-acls:*)",
      "Bash(warpstream cli-old delete-broker-config:*)",
      "Bash(warpstream cli-old delete-topics:*)",
      "Bash(warpstream cli-beta delete-acls:*)",
      "Bash(warpstream cli-beta delete-broker-config:*)",
      "Bash(warpstream cli-beta delete-topics:*)"
    ],
    "defaultMode": "plan"
  },
  "model": "claude-opus-5",
  "effortLevel": "xhigh",
  "enableAllProjectMcpServers": true,
  "env": {
    "AWS_PAGER": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/.system/hooks/git-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/glass.aiff"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/.system/hooks/check-shell.sh"
          },
          {
            "type": "command",
            "command": "~/.config/.system/hooks/check-python.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/.system/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  // @machine:server
  "apiKeyHelper": "$HOME/.config/.system/sensitive/claude-api-key-helper.sh",
  // @end:server
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    // @machine:work
    "Laurel@Laurel": true,
    "slack@claude-plugins-official": true,
    // @end:work
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": false,
    "serena@@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "data-engineering@claude-plugins-official": true,
    "sourcegraphg@claude-plugins-official": true,
    "deploy-on-awsg@claude-plugins-official": true,
    "ruby-lspg@claude-plugins-official": true,
    "sonatype-guideg@claude-plugins-official": true,
    "datag@claude-plugins-official": true,
    "mongodbg@claude-plugins-official": true,
    "databases-on-aws@claude-plugins-official": true,
    "aws-dev-toolkit@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "basedpyright-lsp@dotfiles": true
  },
  "extraKnownMarketplaces": {
    "dotfiles": {
      "source": {
        "source": "directory",
        "path": "$HOME/.config/claude/local-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true
}
